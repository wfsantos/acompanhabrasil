# ==============================================================================
# AcompanhaBrasil — Configurações de Ambiente (Produção / MySQL)
# Copie este arquivo para .env e ajuste com as credenciais do seu banco de dados
# ==============================================================================

# Porta do Servidor Web
PORT=3000
NODE_ENV=development

# Segredos Criptográficos (LGPD & Sessão)
# ATENÇÃO EM PRODUÇÃO: Gere chaves aleatórias e seguras com 64 caracteres hexadecimais!
# Exemplo no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_jwt_secreta_super_segura_minimo_32_caracteres_2026
HMAC_SALT=seu_salt_hmac_para_anonimizacao_cidada_lgpd_2026

# ==============================================================================
# Configuração do Banco de Dados MySQL
# ==============================================================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_NAME=acompanhabrasil

# URL Completa de Conexão MySQL (Opcional - Usada em Cloud / Railway / Render)
# DATABASE_URL=mysql://usuario:senha@localhost:3306/acompanhabrasil

# Fallback SQLite (opcional caso queira executar sem servidor MySQL ativo)
DB_FILE=database.sqlite

# ==============================================================================
# Integração Oficial TSE (Produção)
# ==============================================================================
# URL da API do TSE (opcional para integração direta)
# TSE_API_URL=https://api.tse.jus.br/v1/secao-eleitoral
# TSE_API_KEY=sua_chave_api_tse_producao

# Limite de Tamanho de Upload de Imagem (em Bytes - padrão: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Configuração de CORS (URLs permitidas separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
