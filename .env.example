# ==============================================================================
# AcompanhaBrasil — Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# ==============================================================================

# Porta do Servidor
PORT=3000
NODE_ENV=development

# Segredos de Criptografia e Sessão
# ATENÇÃO: Gere chaves aleatórias e seguras em produção!
# Exemplo para gerar chave no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_jwt_secreta_super_segura_minimo_32_caracteres_12345
HMAC_SALT=seu_salt_hmac_para_anonimizacao_cidada_segredo_2026

# Configuração do Banco de Dados
# 'sqlite' para desenvolvimento local ou 'postgres' para produção
DB_TYPE=sqlite
DB_FILE=database.sqlite

# Configuração PostgreSQL (caso DB_TYPE=postgres)
# DATABASE_URL=postgres://usuario:senha@localhost:5432/acompanhabrasil

# Limite de Tamanho de Upload de Imagem (em Bytes - padrão: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Configuração de CORS (URLs permitidas separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
